<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="solt_api_connector.Onboarding">
        <div t-if="state.steps.length and state.closed" class="d-print-none text-end px-3 py-1 border-bottom">
            <a href="#" class="small text-muted" t-on-click.prevent="onReopen">
                <i class="fa fa-magic me-1"/>Show the setup guide
            </a>
        </div>
        <div t-elif="state.steps.length" class="o_onboarding_main d-print-none position-relative border-bottom overflow-hidden">
            <div class="o_onboarding_wrap py-3 py-lg-4">
                <a href="#" class="o_onboarding_btn_close position-absolute top-0 end-0 py-2 px-3 h2"
                   title="Close the setup guide" t-on-click.prevent="onClose">
                    <i class="oi oi-close"/>
                </a>
                <div class="o_onboarding_steps d-flex">
                    <div t-foreach="requiredSteps" t-as="step" t-key="step.id"
                         class="o_onboarding_step position-relative d-flex flex-column align-items-center justify-content-start text-center"
                         t-att-data-step-state="step.done ? 'done' : 'not_done'">
                        <div class="o_onboarding_line position-absolute"/>
                        <div class="o_onboarding_step_side d-flex">
                            <img class="z-1" t-att-src="imageUrl(step)" t-att-alt="step.title"/>
                        </div>
                        <div class="o_onboarding_step_content position-relative pt-2 flex-grow-1 d-flex flex-column align-items-center justify-content-around">
                            <div class="o_onboarding_step_content_info flex-grow-1 mb-2">
                                <h5 class="o_onboarding_step_title mb-1" t-out="step.title"/>
                                <p class="m-0 small" t-out="step.description"/>
                            </div>
                            <t t-call="solt_api_connector.OnboardingStepAction"/>
                        </div>
                    </div>
                </div>
                <div t-foreach="optionalSteps" t-as="step" t-key="step.id"
                     class="d-flex flex-wrap align-items-center justify-content-center gap-3 mt-3 pt-3 px-3 border-top text-center">
                    <img t-att-src="imageUrl(step)" t-att-alt="step.title" style="width: 40px; height: 40px;"/>
                    <div class="text-start" style="max-width: 560px;">
                        <h6 class="mb-0">
                            <t t-out="step.title"/>
                            <span class="badge text-bg-secondary ms-1">Optional</span>
                        </h6>
                        <p class="m-0 small" t-out="step.description"/>
                    </div>
                    <t t-call="solt_api_connector.OnboardingStepAction">
                        <t t-set="compact" t-value="true"/>
                    </t>
                </div>
            </div>
        </div>
    </t>

    <t t-name="solt_api_connector.OnboardingStepAction">
        <span t-if="step.blocked and !step.done" class="small text-muted" t-out="step.blocked"/>
        <a t-elif="!step.done" href="#" role="button"
           t-att-class="compact ? 'btn btn-outline-primary btn-sm px-3' : 'o_onboarding_step_action btn px-4'"
           t-on-click.prevent="() => this.onStepClick(step)">
            <span t-out="step.button_text"/>
        </a>
        <a t-else="" href="#" role="button"
           t-att-class="compact ? 'btn btn-sm text-success' : 'o_onboarding_step_action__done btn'"
           t-on-click.prevent="() => this.onStepClick(step)">
            <span>
                <i class="p-1 me-1 fa fa-check rounded-circle"/>
                <t t-out="step.done_text"/>
            </span>
        </a>
        <div t-if="step.done and step.detail" class="small text-muted mt-1" t-out="step.detail"/>
        <a t-if="step.done and step.can_change" href="#" class="small" t-on-click.prevent="() => this.onStepClick(step)">Change</a>
    </t>

</templates>
