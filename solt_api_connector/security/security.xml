<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_api_integration" model="ir.module.category">
        <field name="name">API Integration</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_api_integration">
        <field name="name">API Integration</field>
        <field name="category_id" ref="module_category_api_integration"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_api_integration_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_api_integration"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
