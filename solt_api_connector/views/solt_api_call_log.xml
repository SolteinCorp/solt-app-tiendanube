<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vistas para solt.api.call.log -->
    <record id="view_solt_api_call_log_form" model="ir.ui.view">
        <field name="name">solt.api.call.log.form</field>
        <field name="model">solt.api.call.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="connector_id"/>
                            <field name="endpoint_id"/>
                            <field name="request_method" />
                            <field name="request_url" widget="url"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="response_code"/>
                            <field name="duration" widget="float_time"/>
                            <field name="success"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request" name="request">
                            <group>
                                <field name="request_headers" widget="ace" readonly="1"/>
                                <field name="request_params" widget="ace" readonly="1"/>
                                <field name="request_body" widget="ace" readonly="1"/>
                            </group>
                        </page>
                        <page string="Response" name="response">
                            <group>
                                <field name="response_body" widget="ace" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_solt_api_call_log_list" model="ir.ui.view">
        <field name="name">solt.api.call.log.list</field>
        <field name="model">solt.api.call.log</field>
        <field name="arch" type="xml">
            <list decoration-success="success" decoration-danger="not success">
                <field name="create_date"/>
                <field name="name"/>
                <field name="connector_id"/>
                <field name="endpoint_id"/>
                <field name="request_method"/>
                <field name="response_code"/>
                <field name="duration" string="Tiempo (s)"/>
                <field name="success" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_solt_api_call_log_graph" model="ir.ui.view">
        <field name="name">solt.api.call.log.graph</field>
        <field name="model">solt.api.call.log</field>
        <field name="arch" type="xml">
            <graph string="Estadísticas de llamadas API" type="line" sample="1">
                <field name="create_date" interval="day"/>
                <field name="connector_id" type="row"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_solt_api_call_log_pivot" model="ir.ui.view">
        <field name="name">solt.api.call.log.pivot</field>
        <field name="model">solt.api.call.log</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Llamadas API" sample="1">
                <field name="connector_id" type="row"/>
                <field name="endpoint_id" type="row"/>
                <field name="request_method" type="col"/>
                <field name="success" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_solt_api_call_log_search" model="ir.ui.view">
        <field name="name">solt.api.call.log.search</field>
        <field name="model">solt.api.call.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="connector_id"/>
                <field name="endpoint_id"/>
                <field name="request_url"/>
                <field name="response_code"/>
                <filter string="Exitosas" name="successful" domain="[('success', '=', True)]"/>
                <filter string="Fallidas" name="failed" domain="[('success', '=', False)]"/>
                <filter string="Hoy" name="today"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <filter string="Ayer" name="yesterday"
                        domain="[('create_date', '&gt;=', ((context_today()) - datetime.timedelta(days=1)).strftime('%Y-%m-%d')), ('create_date', '&lt;', (context_today()).strftime('%Y-%m-%d'))]"/>
                <filter string="Esta semana" name="this_week"
                        domain="[('create_date', '&gt;=', ((context_today()) - datetime.timedelta(days=(context_today().weekday()))).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Conector" name="group_by_connector" context="{'group_by':'connector_id'}"/>
                    <filter string="Endpoint" name="group_by_endpoint" context="{'group_by':'endpoint_id'}"/>
                    <filter string="Método" name="group_by_method" context="{'group_by':'request_method'}"/>
                    <filter string="Código de Respuesta" name="group_by_code" context="{'group_by':'response_code'}"/>
                    <filter string="Fecha" name="group_by_date" context="{'group_by':'create_date:day'}"/>
                    <filter string="Mes" name="group_by_month" context="{'group_by':'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_solt_api_call_log" model="ir.actions.act_window">
        <field name="name">Logs de Llamadas API</field>
        <field name="res_model">solt.api.call.log</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{'search_default_group_by_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay logs de llamadas API
            </p>
            <p>
                Los logs de llamadas API registran las interacciones con servicios externos.
            </p>
        </field>
    </record>
</odoo>