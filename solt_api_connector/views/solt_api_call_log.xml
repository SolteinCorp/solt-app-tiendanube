<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vistas para solt.api.call.log -->
    <record id="view_solt_api_call_log_form" model="ir.ui.view">
        <field name="name">solt.api.call.log.form</field>
        <field name="model">solt.api.call.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="connector_id"/>
                            <field name="company_id"/>
                            <field name="automation_id"/>
                            <field name="endpoint_id"/>
                            <field name="direction"/>
                            <field name="request_method"/>
                            <field name="request_url" widget="url"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="response_code"/>
                            <field name="duration" widget="float_time"/>
                            <field name="success"/>
                            <field name="res_model_id" invisible="not res_model_id"/>
                            <field name="res_id" invisible="not res_id"/>
                        </group>
                    </group>

                    <!-- Retry status banner (only shown when retry system is active) -->
                    <group string="Retry status" invisible="not retry_state">
                        <group>
                            <field name="retry_state" widget="badge"
                                   decoration-warning="retry_state == 'pending'"
                                   decoration-info="retry_state == 'retrying'"
                                   decoration-success="retry_state == 'resolved'"
                                   decoration-danger="retry_state == 'exhausted'"/>
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                        </group>
                        <group>
                            <field name="next_retry_at" invisible="retry_state not in ('pending', 'retrying')"/>
                            <field name="is_retry"/>
                            <field name="original_log_id" invisible="not original_log_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Request" name="request">
                            <group>
                                <field name="request_headers" widget="ace" readonly="1"/>
                                <field name="request_params" widget="ace" readonly="1"/>
                                <field name="request_body" widget="ace" readonly="1"/>
                            </group>
                        </page>
                        <page string="Response" name="response">
                            <group>
                                <field name="response_headers" widget="ace" readonly="1"/>
                                <field name="response_body" widget="ace" readonly="1"/>
                            </group>
                        </page>
                        <page string="Retry attempts" name="retries"
                              invisible="not retry_state or is_retry">
                            <field name="child_log_ids" readonly="1">
                                <list decoration-success="success" decoration-danger="not success">
                                    <field name="create_date" string="Attempted at"/>
                                    <field name="response_code"/>
                                    <field name="response_body" optional="hide"/>
                                    <field name="duration" string="Duration (s)"/>
                                    <field name="success" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_solt_api_call_log_list" model="ir.ui.view">
        <field name="name">solt.api.call.log.list</field>
        <field name="model">solt.api.call.log</field>
        <field name="arch" type="xml">
            <list decoration-success="success" decoration-danger="not success">
                <field name="create_date"/>
                <field name="name"/>
                <field name="direction"/>
                <field name="company_id"/>
                <field name="connector_id"/>
                <field name="automation_id" optional="show"/>
                <field name="endpoint_id"/>
                <field name="request_method"/>
                <field name="response_code"/>
                <field name="duration" string="Duration (s)"/>
                <field name="retry_state" optional="show" widget="badge"
                       decoration-warning="retry_state == 'pending'"
                       decoration-info="retry_state == 'retrying'"
                       decoration-success="retry_state == 'resolved'"
                       decoration-danger="retry_state == 'exhausted'"/>
                <field name="retry_count" optional="hide"/>
                <field name="success" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_solt_api_call_log_graph" model="ir.ui.view">
        <field name="name">solt.api.call.log.graph</field>
        <field name="model">solt.api.call.log</field>
        <field name="arch" type="xml">
            <graph string="API Call Statistics" type="line" sample="1">
                <field name="create_date" interval="day"/>
                <field name="connector_id" type="row"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_solt_api_call_log_pivot" model="ir.ui.view">
        <field name="name">solt.api.call.log.pivot</field>
        <field name="model">solt.api.call.log</field>
        <field name="arch" type="xml">
            <pivot string="API Call Analysis" sample="1">
                <field name="connector_id" type="row"/>
                <field name="endpoint_id" type="row"/>
                <field name="request_method" type="col"/>
                <field name="success" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_solt_api_call_log_search" model="ir.ui.view">
        <field name="name">solt.api.call.log.search</field>
        <field name="model">solt.api.call.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="connector_id"/>
                <field name="company_id"/>
                <field name="automation_id"/>
                <field name="endpoint_id"/>
                <field name="request_url"/>
                <field name="response_code"/>
                <filter string="Successful" name="successful" domain="[('success', '=', True)]"/>
                <filter string="Failed" name="failed" domain="[('success', '=', False)]"/>
                <separator/>
                <filter string="Outgoing" name="outgoing" domain="[('direction', '=', 'outgoing')]"/>
                <filter string="Incoming" name="incoming" domain="[('direction', '=', 'incoming')]"/>
                <separator/>
                <filter string="Retry: Pending" name="retry_pending"
                        domain="[('retry_state', '=', 'pending')]"/>
                <filter string="Retry: Exhausted" name="retry_exhausted"
                        domain="[('retry_state', '=', 'exhausted')]"/>
                <filter string="Retries active" name="retry_active"
                        domain="[('retry_state', 'in', ('pending', 'retrying', 'exhausted'))]"/>
                <filter string="Is retry attempt" name="is_retry"
                        domain="[('is_retry', '=', True)]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <filter string="Yesterday" name="yesterday"
                        domain="[('create_date', '&gt;=', ((context_today()) - datetime.timedelta(days=1)).strftime('%Y-%m-%d')), ('create_date', '&lt;', (context_today()).strftime('%Y-%m-%d'))]"/>
                <filter string="This week" name="this_week"
                        domain="[('create_date', '&gt;=', ((context_today()) - datetime.timedelta(days=(context_today().weekday()))).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_by_company" context="{'group_by':'company_id'}"/>
                    <filter string="Connector" name="group_by_connector" context="{'group_by':'connector_id'}"/>
                    <filter string="Automation" name="group_by_automation" context="{'group_by':'automation_id'}"/>
                    <filter string="Direction" name="group_by_direction" context="{'group_by':'direction'}"/>
                    <filter string="Endpoint" name="group_by_endpoint" context="{'group_by':'endpoint_id'}"/>
                    <filter string="Method" name="group_by_method" context="{'group_by':'request_method'}"/>
                    <filter string="Response Code" name="group_by_code" context="{'group_by':'response_code'}"/>
                    <filter string="Retry state" name="group_by_retry_state" context="{'group_by':'retry_state'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by':'create_date:day'}"/>
                    <filter string="Month" name="group_by_month" context="{'group_by':'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main action: all logs -->
    <record id="action_solt_api_call_log" model="ir.actions.act_window">
        <field name="name">API Call Logs</field>
        <field name="res_model">solt.api.call.log</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{'search_default_group_by_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No API call logs yet
            </p>
            <p>
                API call logs record every interaction with external services.
            </p>
        </field>
    </record>

    <!-- Filtered action: pending and exhausted retries -->
    <record id="action_solt_api_call_log_retries" model="ir.actions.act_window">
        <field name="name">Pending / Exhausted Retries</field>
        <field name="res_model">solt.api.call.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('retry_state', 'in', ('pending', 'retrying', 'exhausted')), ('is_retry', '=', False)]</field>
        <field name="context">{'search_default_group_by_retry_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending or exhausted retries
            </p>
            <p>
                This view shows outgoing calls that failed and are waiting for
                a retry or have exhausted all attempts.
            </p>
        </field>
    </record>
</odoo>
