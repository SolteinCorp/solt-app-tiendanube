<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="api_connector_ir_actions_server_form_inherit" model="ir.ui.view">
        <field name="name">api.connector.ir.actions.server</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/group[1]" position="after">
                <group string="Import data" invisible="not connector_id or use_for_initial_export">
                    <group>
                        <field name="connector_id" options="{'no_create': True, 'no_open': True}" invisible="not context.get('default_connector_id', False)"/>
                        <field name="use_for_initial_import" invisible="not connector_id"/>
                        <field name="last_import_date" invisible="not connector_id"/>
                        <field name="importing_state" invisible="not connector_id"/>
                        <field name="import_result" invisible="not connector_id"/>
                    </group>
                </group>

                <group string="Export data" invisible="not connector_id or use_for_initial_import">
                    <group>
                        <field name="connector_id" options="{'no_create': True, 'no_open': True}" invisible="not context.get('default_connector_id', False)"/>
                        <field name="use_for_initial_export" invisible="not connector_id"/>
                        <field name="last_export_date" invisible="not connector_id"/>
                        <field name="exporting_state" invisible="not connector_id"/>
                        <field name="export_result" invisible="not connector_id"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

    <!-- base.automation -->
