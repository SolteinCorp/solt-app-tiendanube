<odoo>
    <!-- Vistas para solt.api.connector -->
    <record id="view_solt_api_connector_form" model="ir.ui.view">
        <field name="name">solt.api.connector.form</field>
        <field name="model">solt.api.connector</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="test_connection" string="Probar Conexión" type="object" class="btn-primary"
                            invisible="auth_type in ['none'] or not active"/>
                    <button name="action_all_active" string="Activar Webhook/Automatizaciones" type="object" class="btn-primary"
                            invisible="not active"
                            confirm="La acción va a activar todos los registros de Webhook/Automatizaciones.¿Deseas continuar?"/>
                    <button name="action_all_inactive" string="Desactivar Webhook/Automatizaciones" type="object" class="btn-primary"
                            invisible="not active"
                            confirm="La acción va a desactivar todos los registros de Webhook/Automatizaciones.¿Deseas continuar?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_call_logs" type="object" class="oe_stat_button" icon="fa-list"
                                title="Ver llamadas API">
                            <field name="call_log_count" widget="statinfo" string="Llamadas API"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del conector"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="base_url"/>
                            <field name="active" readonly="True" force_save="1"/>
                        </group>
                        <group>
                            <field name="auth_type"/>
                            <field name="username"
                                   invisible="auth_type != 'basic'"
                                   required="auth_type == 'basic'"/>
                            <field name="password"
                                   invisible="auth_type != 'basic'"
                                   required="auth_type == 'basic'"
                                   password="1"/>
                            <field name="token"
                                   invisible="auth_type not in ['bearer', 'api_key']"
                                   required="auth_type == 'api_key'"/>
                            <field name="api_key_name"
                                   invisible="auth_type != 'api_key'"
                                   required="auth_type == 'api_key'"/>
                            <field name="api_key_in"
                                   invisible="auth_type != 'api_key'"/>
                            <field name="timeout"/>
                        </group>
                    </group>
                    <notebook>
                        <field name="id" invisible="1"/>
                        <page string="Webhook/Automatizaciones" name="automations" invisible="not id">
                            <field name="automation_ids"
                                   context="{'default_solt_connector_id': id, 'active_test': False}">
                                <tree decoration-muted="(not active)">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="trigger"/>
                                    <field name="model_id"/>
                                    <field name="active"/>
                                    <button name="toggle_active" icon="fa-unlock fa-2x" type="object"
                                            title="Activar Webhook/Automations"
                                            invisible="active or not parent.active"
                                            confirm="La acción va a activar la regla.¿Deseas continuar?"
                                    />
                                    <button name="toggle_active" icon="fa-archive fa-2x" type="object"
                                            title="Desactivar Webhook/Automations"
                                            invisible="not active or not parent.active"
                                            confirm="La acción va a desactivar la regla y no se ejecutará.¿Deseas continuar?"
                                    />
                                </tree>
                            </field>
                        </page>
                        <page string="Endpoints" name="endpoints">
                            <field name="endpoint_ids"/>
                        </page>
                        <page string="Companies" name="companies">
                            <field name="company_ids">
                                <tree create="False" edit="False" delete="False" editable="bottom">
                                    <field name="name"/>
                                    <field name="external_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Headers Adicionales" name="headers">
                            <field name="headers" widget="ace"/>
                        </page>
                        <page name="meta_fields" string="Configuración campos predeterminados">
                            <p colspan="2" class="mb-4">Esta sección muestra una lista de todos los campos dinámicos a adicionar por default en los modelos odoo configurados.</p>
                            <button name="action_create_all_meta_fields"
                                    colspan="2"
                                    string="Crear campos meta"
                                    type="object"
                                    confirm="La acción va a adicionar los campos dinámicos en los modelos odoo configurado y en las vistas configuradas."/>
                            <field name="meta_field_ids" nolabel="1" mode="tree,form" context="{'default_connector_id': active_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="model_id"/>
                                </tree>
                                <form string="Campos meta">
                                    <group>
                                        <group>
                                            <field name="name" required="1"/>
                                            <field name="connector_id" options="{'no_create': True, 'no_open': False}" readonly="True" force_save="1"/>
                                        </group>
                                        <group>
                                            <field name="model_id" domain="[('transient','=',False)]"
                                               required="1"
                                               options="{'no_create': True}"/>
                                        </group>
                                    </group>
                                    <notebook invisible="not model_id">
                                        <page string="Metadatos" name="config_meta">
                                            <group>
                                                <group>
                                                    <field name="create_dinamic_view"/>
                                                    <field name="meta_tab_label" invisible="not create_dinamic_view"/>
                                                    <field name="model" invisible="True"/>
                                                </group>
                                                <group>
                                                    <button name="action_create_meta_fields"
                                                            colspan="2"
                                                            string="Crear campos meta"
                                                            type="object"
                                                            confirm="La acción va a adicionar los campos dinámicos en el modelo odoo configurado y en las vistas configuradas."/>
                                                </group>
                                            </group>
                                            <group string="Vistas">
                                                  <group name="form_view_group">
                                                      <field name="form_view_id"
                                                               domain="[('model','=',model),('type','=','form')]"/>
                                                      <field name="extended_form_view_id"
                                                               domain="[('id','=',0)]" invisible="not create_dinamic_view"/>
                                                      <field name="tree_view_id"
                                                               domain="[('model','=',model),('type','=','tree'),('mode','=','primary')]"/>
                                                      <field name="extended_tree_view_id"
                                                               domain="[('id','=',0)]" invisible="not create_dinamic_view"/>
                                                  </group>
                                                  <group name="search_view_group">
                                                      <field name="search_view_id"
                                                               domain="[('model','=',model),('type','=','search'),('mode','=','primary')]"/>
                                                        <field name="extended_search_view_id"
                                                               domain="[('id','=',0)]" invisible="not create_dinamic_view"/>
                                                  </group>

                                            </group>
                                              <group string="Campos">
                                                  <field name="ir_meta_field_ids" nolabel="1" colspan="2"
                                                         context="{'default_model_id': model_id,'default_model': model}">
                                                        <tree delete="0" create="0">
                                                            <field name="name"/>
                                                            <field name="field_description"/>
                                                            <field name="ttype"/>
                                                        </tree>
                                                  </field>
                                              </group>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                        <page string="Acciones de Carga Inicial" name="initial_import" invisible="not id">
                            <field name="ini_import_acion_server_ids" context="{'default_connector_id': id, 'default_use_for_initial_import': True}">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="model_id"/>
                                    <field name="connector_id" column_invisible="True"/>
                                    <field name="last_import_date" optional="show"/>
                                    <field name="import_result" optional="hide"/>
                                    <field name="importing_state" widget="badge" decoration-warning="importing_state == 'scheduled'"
                                       decoration-info="importing_state == 'running'" decoration-success="importing_state == 'done'"
                                       decoration-danger="importing_state == 'error'" optional="show"/>
                                    <field name="use_for_initial_import" column_invisible="True"/>
                                    <button name="execute_initial_import" icon="fa-cloud-download fa-2x" type="object"
                                            title="Importar"
                                            invisible="not connector_id or not parent.active or not use_for_initial_import"
                                    />
                                </tree>
                            </field>
                        </page>
                        <page string="Acciones de Exportación Inicial" name="initial_export" invisible="not id">
                            <field name="ini_export_action_server_ids" context="{'default_connector_id': id, 'default_use_for_initial_export': True}">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="model_id"/>
                                    <field name="connector_id" column_invisible="True"/>
                                    <field name="last_export_date" optional="show"/>
                                    <field name="export_result" optional="hide"/>
                                    <field name="exporting_state" widget="badge" decoration-warning="exporting_state == 'scheduled'"
                                       decoration-info="exporting_state == 'running'" decoration-success="exporting_state == 'done'"
                                       decoration-danger="exporting_state == 'error'" optional="show"/>
                                    <field name="use_for_initial_export" column_invisible="True"/>
                                    <button name="execute_initial_export" icon="fa-cloud-upload fa-2x" type="object"
                                            title="Importar"
                                            invisible="not connector_id or not parent.active or not use_for_initial_export"
                                    />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_solt_api_connector_tree" model="ir.ui.view">
        <field name="name">solt.api.connector.tree</field>
        <field name="model">solt.api.connector</field>
        <field name="arch" type="xml">
            <tree decoration-muted="(not active)">
                <field name="name"/>
                <field name="base_url"/>
                <field name="auth_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_solt_api_connector_search" model="ir.ui.view">
        <field name="name">solt.api.connector.search</field>
        <field name="model">solt.api.connector</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="base_url"/>
                <separator/>
                <filter string="Todos" name="all" domain="['|', ('active', '=', False), ('active', '=', True)]"/>
                <separator/>
                <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Tipo de Autenticación" name="group_by_auth" context="{'group_by':'auth_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_solt_api_connector_kanban" model="ir.ui.view">
            <field name="name">solt.api.connector.kanban</field>
            <field name="model">solt.api.connector</field>
            <field name="arch" type="xml">
                <kanban class="o_connector_kanban">
                    <field name="name"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="kanban-box">
                            <t t-set="styles" t-value="record.active.raw_value ? '' : 'opacity: 0.5;'"/>

                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill" t-att-style="styles">
                                <t t-set="module_name" t-value="'solt_api_connector'"/>

                                <div id="image_div" class="o_kanban_image_fill_left d-none d-md-block"
                                     t-att-style="'background-image:url(/' + module_name + '/static/description/icon.png); min-width:150px;'"/>

                                <div class="oe_kanban_details d-flex flex-column px-2">
                                    <h2 class=""><field name="name"/></h2>
                                    <div class="row mb-3">
                                        <div class="col text-center">
                                            <a class="hoverable-card d-block pt-2 pb-2 text-black" href="#">
                                                <span class="h2 d-block">
                                                    <field name="company_count" />
                                                </span>
                                                total tiendas sincronizadas
                                            </a>
                                        </div>
                                        <div class="col text-center" id="orders_info">
                                            <a/>
                                        </div>
                                    </div>

                                    <ul id="ul_list" class="mb-3"/>

                                    <div class="btn-group" role="group" aria-label="Acciones de integración" groups="solt_api_connector.group_api_integration_manager">
                                        <button string="Activar" name="toggle_active" type="object" invisible="active"
                                                class="btn btn-outline-success d-inline-block"
                                                confirm="La acción va a activar el conector.¿Deseas continuar?"/>
                                        <button string="Desactivar" name="toggle_active" type="object" invisible="not active"
                                                class="btn btn-outline-danger d-inline-block"
                                                confirm="La acción va a desactivar el conector.¿Deseas continuar?"/>
                                    </div>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    <!-- Acciones de menú -->
    <record id="action_solt_api_connector" model="ir.actions.act_window">
        <field name="name">Conectores API</field>
        <field name="res_model">solt.api.connector</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_all': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo conector API
            </p>
            <p>
                Los conectores API permiten conectar Odoo con servicios externos.
            </p>
        </field>
    </record>

</odoo>