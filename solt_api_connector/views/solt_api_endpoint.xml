<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario mejorada para solt.api.endpoint en Odoo 17 -->
    <record id="view_solt_api_endpoint_form" model="ir.ui.view">
        <field name="name">solt.api.endpoint.form</field>
        <field name="model">solt.api.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del endpoint"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="connector_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="model_id" options="{'no_create': True}" domain="[('transient','=',False)]"/>
                            <field name="code" placeholder="identificador_unico"/>
                        </group>
                        <group>
                            <field name="endpoint_path" placeholder="/ruta/{id}/recurso"/>
                            <field name="method"/>
<!--                            <field name="use_for_initial_import" invisible="method not in ['GET']"/>-->
                        </group>
                    </group>
                    <notebook>
                        <!-- Pestaña para mapeo de solicitud con ejemplos del formato compacto -->
                        <page string="Mapeo de Solicitud" name="request_mapping" invisible="method in ['GET', 'DELETE']">
                            <div class="col-md-6 col-xl-5">
                                <label for="request_as_array" string="Formato del Request como Array"/>
                                <field name="request_as_array"/>
                            </div>
                            <div class="alert alert-info" role="alert">
                                <div class="mb-1">
                                    <strong>Formato para mapeo de solicitud (Odoo → API):</strong>
                                </div>
                                <div class="mb-1">
                                    <pre class="o_format_json_structure">
                                        <code>
                                            {
                                            "client_id": "15612", // Valor constante directo
                                            "client_secret": "a356cdf67a71ca483d309a56315744be646e6d5816531afc",
                                            "grant_type": "authorization_code",
                                            "code": {"payload": "code"}, // Valor del payload
                                            "customer_name": {"field": "partner_id.name"}, // Campo de Odoo
                                            "amount": {"field": "amount_total", "type": "float"}, // Con conversión de tipo
                                            "date": {"field": "date", "transform": "value.strftime('%Y-%m-%d')"}, // Con transformación
                                            "name": {"field": "name", "transform": "method('_get_name', value)"}, // Ejecutar método con transformación
                                            }
                                        </code>
                                    </pre>
                                </div>
                                <div class="mt-3"><strong>Formato Request como Array:</strong></div>
                                <div class="mb-1">
                                    Array Simple
                                    <pre class="o_format_json_structure">
                                        <code>
                                        {
                                            "array_source": "product_variant_ids", // Campo de Odoo One2many o Many2many
                                            "item_mapping": {
                                                "id": {"field": "external_id", "type": "integer"},
                                                "values": {"expression": "[{'en': av.name} for av in item.attribute_value_ids]"},
                                                "price": {"field": "list_price", "transform": "f'{float(value):.2f}'"}
                                            }
                                        }
                                        </code>
                                    </pre>
                                </div>
                                <div class="mb-1">
                                    Array anidados
                                    <pre class="o_format_json_structure">
                                        <code>
                                        {
                                            "id": {"field": "external_id", "type": "integer"},
                                            "variants": {
                                              "source": "product_variant_ids",
                                              "items": [
                                                {
                                                  "id": {"field": "external_id", "type": "integer"},
                                                  "price": {"field": "list_price", "type": "float"},
                                                  "inventory_levels": {
                                                    "source": "stock_quant_ids",
                                                    "items": [
                                                      {
                                                        "stock": {"field": "quantity", "type": "integer"}
                                                      }
                                                    ]
                                                  }
                                                }
                                              ]
                                            }
                                        }
                                        </code>
                                    </pre>
                                </div>
                                <div class="mt-3"><strong>Sintaxis:</strong></div>
                                <ul class="mt-2">
                                    <li><code>"campo_api": "valor"</code> - Valor constante</li>
                                    <li><code>"campo_api": {"field": "campo_odoo.subcampo"}</code> - Campo de Odoo</li>
                                    <li><code>"campo_api": {"payload": "nombre_param"}</code> - Valor del
                                        payload/parámetros</li>
                                    <li><code>"campo_api": {"field": "campo", "type":
                                        "float|integer|string|boolean|date|datetime"}</code> - Con conversión</li>
                                    <li><code>"campo_api": {"field": "campo", "transform": "código Python que usa
                                        'value'"}</code> - Con transformación</li>
                                    <li><code>"campo_api": {"expression": "Para expresiones Python complejas con acceso a 'item' y 'env'"}</code> - Con expresiones Python</li>
                                </ul>
                            </div>
                            <field name="request_mapping" widget="ace" placeholder='{
  "client_id": "15612",
  "client_secret": "a356cdf67a71ca483d309a56315744be646e6d5816531afc",
  "grant_type": "authorization_code",
  "code": {"payload": "code"}
}' required="method in ['PUT', 'POST']"/>
                        </page>

                        <!-- Pestaña para mapeo de respuesta con ejemplos usando expresiones Python -->
                        <page string="Mapeo de Respuesta" name="response_mapping" invisible="method in ['DELETE']">
                            <div class="alert alert-info" role="alert">
                                <div class="mb-1">
                                    <strong>Mapeo con expresiones Python (API → Odoo):</strong>
                                </div>
                                <div class="mb-1">
                                    <pre class="o_format_json_structure">
                                        <code>
                                        {
                                        "name": "data['name']", // Acceso directo a un campo
                                        "reference": "data.get('ref', '')", // Con valor por defecto
                                        "date_order": "fields.Date.to_date(data['date'])", // Conversión de tipo
                                        "amount_total": "float(data['amount']) * 1.16", // Operación matemática
                                        "state": "'paid' if float(data['amount']) > 0 else 'draft'", // Condicional

                                        // Campo relacional (many2one)
                                        "partner_id": "env['res.partner'].search([('ref', '=', data['customer_id'])],
                                        limit=1).id",

                                        // Crear registro si no existe
                                        "partner_id": "env['res.partner'].search([('ref', '=', data['customer_id'])],
                                        limit=1).id or env['res.partner'].create({'ref': data['customer_id'], 'name':
                                        data['customer_name']}).id",

                                        // Líneas one2many usando list comprehension
                                        "line_ids": "[Command.create({'product_id':
                                        env['product.product'].search([('default_code', '=', item['code'])], limit=1).id,
                                        'quantity': float(item['qty']), 'price_unit': float(item['price'])}) for item in
                                        data.get('items', [])]"

                                        // Ejecutar funciones pasando su nombre y parámetros
                                            "name": "method('func_name', data.get('name'))"
                                        }
                                    </code>
                                </pre>
                                </div>
                                <div class="mt-3">Las expresiones tienen acceso a:</div>
                                <ul class="mt-2">
                                    <li><code>data</code>: Datos recibidos de la API</li>
                                    <li><code>env</code>: Environment de Odoo</li>
                                    <li><code>record</code>: Registro actual (en actualizaciones)</li>
                                    <li><code>fields</code>: Módulo fields para conversiones</li>
                                    <li><code>Command</code>: Para comandos one2many/many2many</li>
                                    <li><code>datetime</code>, <code>json</code>, <code>re</code>: Módulos Python
                                        útiles</li>
                                    <li><code>method</code>: Ejecutar funciones de Odoo</li>
                                </ul>
                            </div>
                            <field name="response_mapping" widget="ace" placeholder='{
  "name": "data[\"name\"]",
  "amount_total": "float(data[\"amount\"]) * 1.16",
  "partner_id": "env[\"res.partner\"].search([(\"ref\", \"=\", data[\"customer_id\"])], limit=1).id or env[\"res.partner\"].create({\"ref\": data[\"customer_id\"], \"name\": data[\"customer_name\"]}).id"
}'/>
                        </page>

                        <!-- Pestaña para configuración de parámetros -->
                        <page string="Parámetros" name="parameters" invisible="method != 'GET'">
                            <div class="alert alert-info" role="alert">
                                <div class="mb-3">
                                    <strong>Parámetros para solicitud GET:</strong>
                                </div>
                                <div class="mb-1">
                                    <pre class="o_format_json_structure">
                                        <code>
                                            {
                                            "cliente_id": {"field": "partner_id.id"}, // Parámetro dinámico desde campo Odoo
                                            "estado": "activo", // Parámetro con valor fijo
                                            "token": {"payload": "token"} // Parámetro desde el payload
                                            }
                                        </code>
                                    </pre>
                                </div>
                            </div>
                            <field name="request_param" widget="ace" placeholder='{
                              "client_id": "15612",
                              "redirect_uri": "https://example.com/callback"
                            }'/>
                        </page>
                        <page string="Encabezado" name="headers">
                            <field name="headers" widget="ace"  placeholder='{
                          "client_id": "15612",
                          "redirect_uri": "https://example.com/callback"
                        }'/>
                        </page>
                        <!-- Pestaña para configuración de Campos requeridos de API -->
                        <page string="Campos requeridos" name="required_request" invisible="method not in ['POST', 'PUT']">
                            <group>
                                <field name="check_required_request_field"/>
                            </group>
                            <field name="required_request_field"  widget="ace" placeholder='{
                             "id": "x_external_id"
                            }' required="check_required_request_field == True" invisible="check_required_request_field == False"/>
                        </page>

                        <!-- Pestaña para configuración de paginación -->
                        <page string="Paginación" name="pagination" invisible="method != 'GET'">
                            <group>
                                <field name="pagination_enabled"/>
                                <field name="pagination_param"
                                       invisible="not pagination_enabled"
                                       required="pagination_enabled"
                                       placeholder="page"/>
                                <field name="pagination_size_param"
                                       invisible="not pagination_enabled"
                                       required="pagination_enabled"
                                       placeholder="limit"/>
                                <field name="pagination_size"
                                       invisible="not pagination_enabled"
                                       required="pagination_enabled"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de árbol para solt.api.endpoint -->
    <record id="view_solt_api_endpoint_tree" model="ir.ui.view">
        <field name="name">solt.api.endpoint.tree</field>
        <field name="model">solt.api.endpoint</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="connector_id"/>
                <field name="endpoint_path"/>
                <field name="method"/>
                <field name="model_id"/>
<!--                <field name="use_for_initial_import" optional="show"/>-->
            </tree>
        </field>
    </record>

    <!-- Vista de búsqueda para solt.api.endpoint -->
    <record id="view_solt_api_endpoint_search" model="ir.ui.view">
        <field name="name">solt.api.endpoint.search</field>
        <field name="model">solt.api.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="endpoint_path"/>
                <field name="connector_id"/>
                <field name="model_id"/>
<!--                <filter string="Carga inicial" name="filter_initial_import" domain="[('use_for_initial_import', '=', True)]"/>-->
                <group>
                    <filter string="Conector" name="group_by_connector" context="{'group_by':'connector_id'}"/>
                    <filter string="Método" name="group_by_method" context="{'group_by':'method'}"/>
                    <filter string="Modelo" name="group_by_model" context="{'group_by':'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de menú para solt.api.endpoint -->
    <record id="action_solt_api_endpoint" model="ir.actions.act_window">
        <field name="name">Endpoints API</field>
        <field name="res_model">solt.api.endpoint</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo endpoint API
            </p>
            <p>
                Los endpoints API definen las operaciones disponibles en los conectores.
            </p>
        </field>
    </record>
</odoo>