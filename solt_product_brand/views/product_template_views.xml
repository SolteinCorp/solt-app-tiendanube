<odoo>
    <data>
        <!-- product.template -->
        <record id="view_product_template_search_brand_inherit" model="ir.ui.view">
            <field name="name">product.template.search.brand.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <field name="categ_id" position="after">
                    <field name="product_brand_id"/>
                </field>
                <filter name="categ_id" position="after">
                    <filter string="Brand" name="groupby_brand" context="{'group_by' : 'product_brand_id'}"
                    />
                </filter>

            </field>
        </record>

        <record id="view_product_template_tree_brand_inherit" model="ir.ui.view">
            <field name="name">product.template.brand.list.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="product_brand_id" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_product_template_kanban_brand_inherit" model="ir.ui.view">
            <field name="name">product.tempalte.brand.kanban.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_properties']" position="before">
                    <br t-if="record.product_brand_id"/>
                    <span name="product_brand" t-if="record.product_brand_id">
                        Brand: <field name="product_brand_id"/>
                    </span>
                </xpath>
            </field>
        </record>

        <record id="product_template_form_brand_inherit" model="ir.ui.view">
            <field name="name">product.template.brand.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <group name="group_general" position="inside">
                    <field name="product_brand_id" placeholder="Brand" options="{'no_create': False}"/>
                </group>
            </field>
        </record>

        <!-- product.product -->
        <record id="view_product_product_kanban_brand_inherit" model="ir.ui.view">
            <field name="name">product.product.brand.kanban.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//main[hasclass('col-10', 'pe-2')]" position="inside">
                    <br t-if="record.product_brand_id"/>
                    <span t-if="record.product_brand_id">
                        Brand: <field name="product_brand_id"/>
                    </span>
                </xpath>
            </field>
        </record>
        <record id="view_product_product_tree_brand_inherit" model="ir.ui.view">
            <field name="name">product.product.brand.list.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="product_brand_id" optional="hide"/>
                </field>
            </field>
        </record>


    </data>
</odoo>
