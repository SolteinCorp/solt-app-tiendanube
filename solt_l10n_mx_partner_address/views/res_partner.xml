<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mx_partner_address_form" model="ir.ui.view">
            <field name="name">l10n_mx.res.partner.address.form</field>
            <field name="model">res.partner</field>
            <field name="priority" eval="900"/>
            <field name="arch" type="xml">
                <form>
                    <div class="o_address_format">
                        <field name="country_enforce_cities" invisible="1"/>
                        <field name="parent_id" invisible="1"/>
                        <field name="is_company" invisible="1"/>
                        <field name="type" invisible="1"/>
                        <field name="street" placeholder="Street..." class="o_address_street oe_read_only"/>
                        <div class="oe_edit_only o_row">
                            <field name="street_name" placeholder="Street" style="flex: 3 1 auto"
                                   readonly="type == 'contact' and parent_id"/>
                        </div>
                        <div class="oe_edit_only o_row">
                            <field name="street_number" placeholder="House #" style="flex: 1 1 auto"
                                   readonly="type == 'contact' and parent_id"/>
                            <span> - </span>
                            <field name="street_number2" placeholder="Door #" style="flex: 1 1 auto"
                                   readonly="type == 'contact' and parent_id"/>
                        </div>
                        <field name="street2" placeholder="Street 2..." class="o_address_street" readonly="type == 'contact' and parent_id"/>
                        <field name="country_id"
                               placeholder="Country"
                               class="o_address_country"
                               readonly="type == 'contact' and parent_id"
                               options='{"no_open": True, "no_create": True}'/>
                        <div class="o_address_street">
                            <field name="state_id"
                                   class="o_address_state"
                                   placeholder="State"
                                   options="{'no_open': True, 'no_quick_create': True}"
                                   readonly="type == 'contact' and parent_id"
                                   context="{'default_country_id': country_id}"/>
                            <field name="city_id"
                                   placeholder="City"
                                   domain="[('country_id', '=', country_id)]"
                                   invisible="not country_enforce_cities"
                                   readonly="type == 'contact' and parent_id"
                                   context="{'default_country_id': country_id, 'default_state_id': state_id, 'default_zipcode': zip}"/>
                            <field name="city"
                                   placeholder="City"
                                   class="o_address_city"
                                   invisible="country_enforce_cities and (city_id or city in ['', False])"
                                   readonly="type == 'contact' and parent_id"/>
                        </div>
                        <div class="o_address_street">
                            <field name="l10n_mx_locality_id"
                                   placeholder="Locality..."
                                   domain="[('state_id','=', state_id)]"
                                   options='{"no_create": True}'
                                   readonly="type == 'contact' and parent_id"/>
                            <field name="l10n_mx_locality"
                                   invisible="l10n_mx_locality_id or l10n_mx_locality in ['', False]"
                                   readonly="type == 'contact' and parent_id"
                                   placeholder="Locality..."/>
                        </div>
                        <div class="o_address_street" invisible="not is_company">
                            <field name="l10n_mx_colony" placeholder="Colony..." style="flex: 2 1 auto"
                                   readonly="type == 'contact' and parent_id"/>
                            <span></span>
                            <field name="l10n_mx_colony_code" placeholder="Colony Code..." style="flex: 2 1 auto"
                                   readonly="type == 'contact' and parent_id"/>
                        </div>
                        <field name="zip" placeholder="ZIP" class="o_address_zip"
                               readonly="type == 'contact' and parent_id"/>
                    </div>
                </form>
            </field>
        </record>

    </data>
</odoo>
