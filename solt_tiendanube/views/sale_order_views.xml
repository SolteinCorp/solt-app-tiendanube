<odoo>
        <!-- Inherit Form View to Modify it -->
        <record id="nube_sale_order_form_inherit" model="ir.ui.view">
            <field name="name">nube.sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page name="integration_page" string="Tiendanube Integration">
                        <group>
                            <field name="order_number" readonly="1" force_save="1"/>
                            <field name="payment_method_id" readonly="1" force_save="1"/>
                        </group>
                    </page>
                </notebook>
                <field name="origin" position="after">
                    <field name="new_version_id" force_save="1"/>
                </field>
            </field>
        </record>

    <!--
        Acción de servidor: Sincronizar estado de orden desde TiendaNube
        Lógica aplicada (replica webhooks de TN, sin crear órdenes nuevas):
          · open/no pagada   → confirma si draft, sincroniza picking
          · paid             → genera facturas si invoice_status != invoiced
          · fulfilled/full   → bloquea la orden
          · cancelled        → cancela en Odoo + excluye de sync futura
        El estado se obtiene siempre en tiempo real desde la API de TN
    -->
    <record id="action_server_tn_sync_order_state" model="ir.actions.server">
        <field name="name">Sincronizar orden desde TiendaNube</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_tn_sync_state_from_tn()
        </field>
    </record>
</odoo>
