<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_multi_warehouse" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.multi.warehouse</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- In Odoo 19, use 'delivery' setting which exists in the Shipping block -->
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="manage_multy_stock_catalog" title="Use multi warehouse in Sales Orders" help="Allows using multi warehouse in Sales Orders">
                    <field name="use_sale_multi_stock"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>

